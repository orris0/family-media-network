{
  "name": "academic-pages",
  "version": "0.8.1.1",
  "description": "Secure trauma-informed advocacy and web book learning deployment application for Academic Pages",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/academicpages/academicpages.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal",
    "express",
    "security",
    "jquery-novice-to-ninja",
    "css-secrets",
    "advocacy",
    "nyc-shelter-registry"
  ],
  "author": "Family Media Network Collective"
},
"contributors": [
  "Michael Rose",
  "Robert Zupko"
],
"license": "MIT",
"bugs": {
  "url": "https://github.com/academicpages/academicpages.github.io/issues"
},
"homepage": "https://github.com/academicpages/academicpages.github.io",
"engines": {
  "node": ">= 0.10.0",
  "node": ">=18.0.0"
},
"dependencies": {
  "fitvids": "^2.1.1",
  "jquery": "^3.7.1",
  "jquery-smooth-scroll": "^2.2.0",
  "magnific-popup": "^1.2.0",
  "cors": "^2.8.5",
  "dotenv": "^16.4.5",
  "express": "^4.19.2",
  "helmet": "^7.1.0"
},
"devDependencies": {
  "onchange": "^7.1.0",
  "uglify-js": "^3.17.4",
  "nodemon": "^3.1.0"
},
"scripts": {
  "start": "node server.js",
  "dev": "nodemon server.js",
  "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js node_modules/fitvids/dist/fitvids.min.js node_modules/magnific-popup/dist/jquery.magnific-popup.min.js node_modules/jquery-smooth-scroll/jquery.smooth-scroll.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
  "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
  "build:js": "npm run uglify"
}
}